# Wayfarer backend env

# Anthropic API key (required for /chat and /briefing/generate)
ANTHROPIC_API_KEY=sk-ant-...

# Path to the SQLite database (defaults to backend/db/wayfarer.db)
DB_PATH=

# CORS origins, comma-separated. Use "*" to allow all (default).
CORS_ORIGINS=*

# Anthropic model to use for v0.5
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google OAuth (optional — defaults to backend/secrets/).
# The runtime loader looks here for client_secret.json and google_token.json.
# Run `python scripts/google_auth.py` once to populate google_token.json.
GOOGLE_SECRETS_DIR=
